  "tasks": [
    {
      "id": "handlebar-install",
      "title": "Stuur monteren",
      "origin": "manual",
      "steps": [
        {
          "text": "Monteer de twee kabelklemmen op het stuur en draai de bouten aan tot 1,0 Nm.",
          "source": {
            "manual": "venge-my19",
            "page": 8
          }
        },
        {
          "text": "Leid de remleidingen naar hun eigen stuurzijde en dan naar de remhendels. Ze kruisen elkaar niet tussen balhoofdbuis en stuur.",
          "source": {
            "manual": "venge-my19",
            "page": 9
          }
        },
        {
          "text": "Houd de beugels naar beneden, leg het stuur tegen de stuurpenklem en draai het in positie.",
          "source": {
            "manual": "venge-my19",
            "page": 9
          }
        },
        {
          "text": "Plaats voorplaat en bouten en draai kruislings aan tot 5,1 Nm (zie Stuurpen).",
          "source": {
            "manual": "venge-my19",
            "page": 9
          }
        },
        {
          "text": "Tip: duw voor het inkorten van de hydraulische leidingen wat extra leiding in het stuur, zodat je later de zithouding nog iets kunt aanpassen.",
          "source": {
            "manual": "venge-my19",
            "page": 9
          }
        }
      ]
    }
  ],
  "warnings": [
    {
      "level": "warning",
      "text": "Het carbon Aerofly 2-stuur is niet geschikt voor opklembare aerobars die op het stuur klemmen.",
      "source": {
        "manual": "venge-my19",
        "page": 8
      }
    },
    {
      "level": "warning",
      "text": "Draai de klembeugel van de remgreep niet om het stuur heen bij het monteren; dit kan het carbon beschadigen.",
      "source": {
        "manual": "venge-my19",
        "page": 8
      }
    }
  ],
