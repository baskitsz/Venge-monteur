  "tasks": [
    {
      "id": "seatpost-install",
      "title": "Zadelpen plaatsen en zadelhoogte vastzetten",
      "origin": "manual",
      "steps": [
        {
          "text": "Vet de contactvlakken tussen het bovenste en onderste wigdeel, de cilinder, en de boutdraad, boutkop en ring van de wigklem in.",
          "source": {
            "manual": "venge-my19",
            "page": 5
          }
        },
        {
          "text": "Breng carbonmontagepasta aan op de zadelpen en steek de zadelpen in de zitbuis. Gebruik geen vet tussen zadelpen en zitbuis.",
          "source": {
            "manual": "venge-my19",
            "page": 5
          }
        },
        {
          "text": "Zet de wigklem in elkaar en plaats die in het frame, vóór de zadelpen.",
          "source": {
            "manual": "venge-my19",
            "page": 5
          }
        },
        {
          "text": "Controleer de minimale (75 mm) en maximale insteekdiepte voor jouw framemaat. De zadelpen mag de uitsparing voor de achterband niet raken.",
          "source": {
            "manual": "venge-my19",
            "page": 5
          }
        },
        {
          "text": "Bepaal de zadelhoogte en draai de wigbout aan tot 6,2 Nm.",
          "source": {
            "manual": "venge-my19",
            "page": 5
          }
        }
      ]
    },
    {
      "id": "seatpost-remove",
      "title": "Zadelpen uitnemen",
      "origin": "manual",
      "steps": [
        {
          "text": "Verwijder eerst Junction A (EW-RS910 / laadpoort) uit de zadelpen.",
          "source": {
            "manual": "venge-my19",
            "page": 3
          }
        },
        {
          "text": "Ontkoppel daarna de 1200 mm-draad uit de zitbuis. Pas dan de zadelpen uitnemen.",
          "source": {
            "manual": "venge-my19",
            "page": 3
          }
        },
        {
          "text": "Neem je de zadelpen vaak uit (bijv. voor transport), dan kan een EW-JC200-tussenstuk met een extra 500 mm-draad aan het eind van de zitbuisdraad worden geplaatst.",
          "source": {
            "manual": "venge-my19",
            "page": 3
          }
        }
      ]
    }
  ],
  "warnings": [
    {
      "level": "warning",
      "text": "Houd je aan de minimale en maximale insteekdiepte; anders kunnen frame of zadelpen beschadigen.",
      "source": {
        "manual": "venge-my19",
        "page": 5
      }
    },
    {
      "level": "warning",
      "text": "Een te los aangedraaide zadelpen kan wegzakken, het frame beschadigen en tot een val leiden.",
      "source": {
        "manual": "venge-my19",
        "page": 5
      }
    },
    {
      "level": "caution",
      "text": "Geen vet tussen zadelpen en zitbuis: vet vermindert de klemkracht. Gebruik carbonmontagepasta.",
      "source": {
        "manual": "venge-my19",
        "page": 5
      }
    },
    {
      "level": "warning",
      "text": "Controleer zadelpen en zitbuis op bramen of scherpe randen en verwijder die met fijn schuurpapier.",
      "source": {
        "manual": "venge-my19",
        "page": 5
      }
    }
  ],
